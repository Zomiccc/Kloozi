# Frontend Environment Variables
# Copy to .env and fill in

# Backend API URL (for OAuth redirects)
VITE_API_URL=http://localhost:5000

# Facebook App ID (for OAuth login dialog)
VITE_FB_APP_ID=your-facebook-app-id

# Shown on the public /privacy, /terms and /data-deletion pages
VITE_LEGAL_COMPANY=Flazyn
VITE_LEGAL_EMAIL=privacy@flazyn.com
VITE_LEGAL_ADDRESS=
VITE_LEGAL_COUNTRY=Australia
# e.g. New South Wales — used in the governing-law clause
VITE_LEGAL_STATE=
# shown on legal pages once issued
VITE_LEGAL_ABN=
