{
  "info": {
    "name": "Flazyn API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/signup",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"companyName\": \"Acme Inc\",\n  \"phone\": \"+1234567890\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.environment.set('accessToken', pm.response.json().accessToken);", "pm.environment.set('refreshToken', pm.response.json().refreshToken);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@demo.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@demo.com\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/leads?page=1&limit=50&search=&stage=&sort="
          }
        },
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/leads",
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Smith\",\n  \"phone\": \"+15551234567\",\n  \"email\": \"alice@example.com\",\n  \"city\": \"New York\",\n  \"budget\": 75000,\n  \"lead_source\": \"facebook\",\n  \"notes\": \"Interested in premium package\"\n}" }
          }
        },
        {
          "name": "Get Lead by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/leads/LEAD_ID"
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/leads/LEAD_ID",
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"interested\",\n  \"budget\": 100000\n}" }
          }
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/leads/LEAD_ID"
          }
        },
        {
          "name": "Import Leads",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/leads/import",
            "body": { "mode": "raw", "raw": "{\n  \"csv_data\": \"first_name,phone,email,city\\nJohn,+15550001111,john@test.com,NYC\\nJane,+15550002222,jane@test.com,LA\",\n  \"field_mapping\": {\"first_name\": \"first_name\", \"phone\": \"phone\", \"email\": \"email\", \"city\": \"city\"}\n}" }
          }
        },
        {
          "name": "Export Leads",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/leads/export",
            "body": { "mode": "raw", "raw": "{\n  \"fields\": [\"first_name\", \"last_name\", \"phone\", \"email\", \"city\", \"budget\", \"stage\"]\n}" }
          }
        },
        {
          "name": "Bulk Actions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/leads/bulk",
            "body": { "mode": "raw", "raw": "{\n  \"lead_ids\": [\"LEAD_ID_1\", \"LEAD_ID_2\"],\n  \"action\": \"change_stage\",\n  \"value\": \"contacted\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Email Marketing",
      "item": [
        {
          "name": "List Templates",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/emails/templates" }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/emails/templates",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Welcome Email\",\n  \"subject\": \"Welcome {{First_Name}}!\",\n  \"body\": \"<h2>Hello {{First_Name}}!</h2><p>Thank you for your interest.</p>\",\n  \"category\": \"intro\",\n  \"is_draft\": false\n}" }
          }
        },
        {
          "name": "AI Subject Lines",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/emails/ai/subject-lines",
            "body": { "mode": "raw", "raw": "{\n  \"topic\": \"property follow-up\",\n  \"goal\": \"get them to reply\"\n}" }
          }
        },
        {
          "name": "List Sequences",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/emails/sequences" }
        },
        {
          "name": "Create Sequence",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/emails/sequences",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hot Lead Sequence\",\n  \"type\": \"hot_lead\",\n  \"description\": \"For hot leads\",\n  \"steps\": [\n    {\"template_id\": \"TEMPLATE_ID\", \"delay_days\": 0, \"delay_hours\": 2},\n    {\"template_id\": \"TEMPLATE_ID\", \"delay_days\": 2, \"delay_hours\": 0}\n  ]\n}" }
          }
        },
        {
          "name": "List Flows",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/emails/flows" }
        },
        {
          "name": "Create Flow",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/emails/flows",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Lead Flow\",\n  \"description\": \"Auto-nurture new leads\"\n}" }
          }
        },
        {
          "name": "Email Analytics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/emails/analytics" }
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "List Campaigns",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/campaigns" }
        },
        {
          "name": "Create Email Campaign",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/campaigns",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Summer Promo\",\n  \"channel\": \"email\",\n  \"template_id\": \"TEMPLATE_ID\",\n  \"filter_config\": {\"stage\": \"interested\"}\n}" }
          }
        },
        {
          "name": "Send Campaign",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/campaigns/CAMPAIGN_ID/send" }
        },
        {
          "name": "Campaign Stats",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/campaigns/CAMPAIGN_ID/stats" }
        }
      ]
    },
    {
      "name": "WhatsApp",
      "item": [
        {
          "name": "List Templates",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/whatsapp/templates" }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/whatsapp/send",
            "body": { "mode": "raw", "raw": "{\n  \"lead_id\": \"LEAD_ID\",\n  \"message\": \"Hello! How can I help you?\"\n}" }
          }
        },
        {
          "name": "Get Conversations",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/whatsapp/conversations" }
        }
      ]
    },
    {
      "name": "SMS",
      "item": [
        {
          "name": "Send SMS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/sms/send",
            "body": { "mode": "raw", "raw": "{\n  \"lead_id\": \"LEAD_ID\",\n  \"message\": \"Hi! Thanks for your interest.\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Calls",
      "item": [
        {
          "name": "Log Call",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/calls/log",
            "body": { "mode": "raw", "raw": "{\n  \"lead_id\": \"LEAD_ID\",\n  \"phone_number\": \"+15551234567\",\n  \"outcome\": \"interested\",\n  \"notes\": \"Client wants more info\",\n  \"duration_seconds\": 180,\n  \"follow_up_scheduled\": \"2025-01-20T10:00:00Z\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Follow-ups",
      "item": [
        {
          "name": "List Follow-ups",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/follow-ups?date=today" }
        },
        {
          "name": "Create Follow-up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/follow-ups",
            "body": { "mode": "raw", "raw": "{\n  \"lead_id\": \"LEAD_ID\",\n  \"type\": \"call\",\n  \"title\": \"Follow up call\",\n  \"notes\": \"Discuss pricing\",\n  \"due_date\": \"2025-01-20T10:00:00Z\"\n}" }
          }
        },
        {
          "name": "Complete Follow-up",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/follow-ups/FOLLOWUP_ID/complete" }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Dashboard",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/analytics/dashboard" }
        },
        {
          "name": "Lead Analytics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/analytics/leads" }
        },
        {
          "name": "Conversion Analytics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/analytics/conversion" }
        },
        {
          "name": "Pipeline Analytics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/analytics/pipeline" }
        },
        {
          "name": "Agent Performance",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/analytics/agents" }
        }
      ]
    },
    {
      "name": "Team",
      "item": [
        {
          "name": "List Members",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/team" }
        },
        {
          "name": "Invite Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/team/invite",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"newagent@example.com\",\n  \"role\": \"sales_agent\",\n  \"first_name\": \"New\",\n  \"last_name\": \"Agent\"\n}" }
          }
        },
        {
          "name": "Get Profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/team/profile" }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Get Plans",
          "request": { "method": "GET", "url": "{{baseUrl}}/billing/plans" }
        },
        {
          "name": "Get Subscription",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/billing/subscription" }
        },
        {
          "name": "Create Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/billing/checkout",
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"pro\",\n  \"billing_cycle\": \"monthly\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Integrations",
      "item": [
        {
          "name": "List Integrations",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/integrations" }
        },
        {
          "name": "Connect Integration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/integrations/connect",
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"facebook\",\n  \"credentials\": {\"api_key\": \"YOUR_KEY\"}\n}" }
          }
        },
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/integrations/webhooks",
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"zapier\",\n  \"field_mapping\": {\"name\": \"first_name\", \"phone\": \"phone\"}\n}" }
          }
        }
      ]
    }
  ]
}
