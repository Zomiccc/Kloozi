{
  "name": "crm-final",
  "version": "1.0.0",
  "private": true,
  "description": "CRM Final - Full-featured CRM SaaS platform with Email Marketing System",
  "scripts": {
    "dev:server": "cd backend && npm run dev",
    "dev:web": "cd web && npm run dev",
    "dev:mobile": "cd mobile && npm run start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build:web": "cd web && npm run build",
    "start:server": "cd backend && npm start",
    "seed": "cd backend && npm run seed",
    "migrate": "cd backend && npm run migrate",
    "setup": "cd backend && npm install && cd ../web && npm install && cd ../mobile && npm install"
  },
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
