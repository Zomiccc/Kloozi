# ════════════════════════════════════════════════════════
# Flazyn - Environment Variables
# ════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_final
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Flazyn

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_TEAM=price_team
STRIPE_PRICE_BUSINESS=price_business

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=flazyn-uploads

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Firebase (FCM)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Meta WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_BUSINESS_ID=your-whatsapp-business-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Meta Facebook Lead Ads
FACEBOOK_APP_ID=your-fb-app-id
FACEBOOK_APP_SECRET=your-fb-app-secret
# Facebook Login for Business → Configurations → Configuration ID
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_VERIFY_TOKEN=your-fb-verify-token

# Google Ads
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token

# TikTok Ads
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret

# LinkedIn Lead Gen
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Meta Conversions API
META_CONVERSIONS_ACCESS_TOKEN=your-meta-conversions-token
META_PIXEL_ID=your-meta-pixel-id

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# App Config
APP_NAME=Flazyn
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ur,ar
AUTO_LOGOUT_MINUTES=60

# Platform API versions (bump when the platform retires the version)
FACEBOOK_GRAPH_VERSION=v25.0
LINKEDIN_API_VERSION=202609

# ─── Automations ───
# Business timezone for auto-responder working hours (per-workspace override in the UI)
DEFAULT_TIMEZONE=Australia/Sydney
# Country code added to local numbers (04xx…) when hashing phones for Meta CAPI
DEFAULT_COUNTRY_CODE=61
# OpenAI model for the WhatsApp AI agent + interest briefs
OPENAI_MODEL=gpt-4o-mini
# Meta CAPI: optional test code from Events Manager → Test events
META_CAPI_TEST_EVENT_CODE=
# WhatsApp Cloud API webhooks are signed with the Meta app secret (defaults to FACEBOOK_APP_SECRET)
WHATSAPP_APP_SECRET=
# Webhook signature checks (Twilio/Meta). Only set to false while debugging a proxy URL mismatch.
WHATSAPP_WEBHOOK_VERIFY=true
SMS_WEBHOOK_VERIFY=true
# true = run every automation but never actually send email/WhatsApp/SMS/Meta events (tests, staging)
MESSAGING_DRY_RUN=false
# Speech-to-text for call recordings and voice notes
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── Managed connections (while platform approvals are pending) ───
# Flazyn's own IDs shown to clients so they can grant partner access in one step
FLAZYN_META_BUSINESS_ID=
FLAZYN_LINKEDIN_MEMBER=Flazyn Connect
FLAZYN_LINKEDIN_PROFILE_URL=
FLAZYN_TIKTOK_BC_ID=
# Flazyn team: who sees the internal Connections queue, and where new requests are emailed
PLATFORM_ADMIN_EMAILS=ashir.qureshi.aqq@gmail.com
PLATFORM_OPS_EMAIL=hello@flazyn.com
